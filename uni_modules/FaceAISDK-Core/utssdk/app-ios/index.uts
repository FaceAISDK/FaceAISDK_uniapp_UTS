/**
 * 「1:1人脸识别」跳转到 SDK 中原生页面处理人脸识别+活体检测
 */
export const faceVerify : FaceVerify = function (
	faceID: string ,
	threshold: number,
	faceLivenessType:number,
	motionLivenessTypes:string,
	motionLivenessTimeOut : number,
	motionLivenessSteps : number,
	callback : (result : ResultJSON) => void
) {
	
	FaceSDKSwiftManager.showFaceVerify(
	    faceID, 
		threshold,
		faceLivenessType,
		motionLivenessTypes,
		motionLivenessTimeOut,
		motionLivenessSteps,
	    (resultCode: number, similarity: number, liveness: number) => {
			let base64Str = "";
			
			if (resultCode == 1 ||resultCode == 10) {
				base64Str = FaceSDKSwiftManager.getFaceImageBase64(faceID)
			}
			
			// 1. 使用 toFixed(2) 得到两位小数的字符串
			// 2. 使用 Number() 转换回数值类型，保持 ResultJSON 定义一致性 [cite: 10]
			// const formattedSimilarity = Number(similarity.toFixed(2));
			// const formattedLiveness = Number(liveness.toFixed(2));
			
		    const resultJson : ResultJSON = {
			    code: resultCode,
			    msg: getMsgByCode(resultCode),
			    faceID: faceID,
                similarity: similarity, 
				liveness: liveness,
			    faceFeature: "-",
			    faceBase64: base64Str
			};
			callback(resultJson);
	    }
	);
}

/**
 * 活体检测
 */
export const livenessVerify : LivenessVerify = function (
	faceLivenessType:number,
	motionLivenessTypes:string,
	motionLivenessTimeOut : number,
	motionLivenessSteps : number,
	callback : (result : ResultJSON) => void
) {
	FaceSDKSwiftManager.showLivenessVerify(
		faceLivenessType,
		motionLivenessTypes,
		motionLivenessTimeOut,
		motionLivenessSteps,
        // 修改：增加 liveness 参数
	    (resultCode: number, liveness: number) => {
			
			let base64Str = "";
			if (resultCode == 1 ||resultCode == 10) {
				base64Str = FaceSDKSwiftManager.getFaceImageBase64("Liveness")
			}
			
		   let msg = getMsgByCode(resultCode);
           const resultJson = {
                code: resultCode,
                msg: msg,
                faceID: "-",
				similarity: 0,
				liveness: liveness,
                faceFeature: "-",  
                faceBase64: base64Str    
            } as ResultJSON;
			callback(resultJson);
	    }
	);
}

/**
 * 获取特征值
 */
export const getFaceFeature : GetFaceFeature = function 
             (faceID : string, callback : (re : ResultJSON) => void) {
				 
		let faceFeature= FaceSDKSwiftManager.getFaceFeature(faceID)		 
		FaceSDKSwiftManager.isFaceFeatureExist(
			faceID,
		    (resultCode: number) => {
		    	const resultJson : ResultJSON = {
				    code: resultCode,
				    msg: "1:exist  0:not exist",
				    faceID: "",
					similarity: 0,
					liveness: 0,
				    faceFeature: faceFeature,
				    faceBase64: ""
				};
				callback(resultJson);
		    }
		);
}


//删除人脸特征
export const deleteFaceFeature: DeleteFaceFeature = function (faceID: string) {
		FaceSDKSwiftManager.deleteFaceFeature(faceID);
}

 
/**
 * 同步特征值
 */
export const insertFaceFeature : InsertFaceFeature = function 
              (faceID : string, faceFeature : string, callback : (result : ResultJSON) => void) {

        FaceSDKSwiftManager.insertFaceFeature(
        	faceID,
        	faceFeature,
            (resultCode: number) => {
        		
		    	const resultJson : ResultJSON = {
        		    code: resultCode,
				    msg: "1:success  0:failed",
        		    faceID: "",
					similarity: 0,
					liveness: 0,
        		    faceFeature: "",
        		    faceBase64: ""
        		};
        		callback(resultJson);
            }
        );
}

